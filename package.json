{
  "name": "agent-context-doctor",
  "version": "0.1.0",
  "description": "A deterministic CLI that audits repository agent context files for quality, safety, contradictions, stale commands, and generic placeholder content.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "acd": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "pack:check": "pnpm pack && rm *.tgz",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf dist docs/agent-context-report.md"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alipajand/agent-context-doctor.git"
  },
  "bugs": {
    "url": "https://github.com/alipajand/agent-context-doctor/issues"
  },
  "homepage": "https://github.com/alipajand/agent-context-doctor#readme",
  "keywords": [
    "agent",
    "context",
    "audit",
    "cli",
    "cursor",
    "copilot",
    "claude",
    "claude-code",
    "codex",
    "ai-agents"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "fast-glob": "^3.3.2",
    "picocolors": "^1.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^4.1.11",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
