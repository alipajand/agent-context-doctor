{
  "name": "agent-context-doctor",
  "version": "0.1.0",
  "description": "A deterministic CLI that audits repository agent context files for quality, safety, contradictions, stale commands, and generic placeholder content.",
  "type": "module",
  "bin": {
    "acd": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist docs/agent-context-report.md"
  },
  "keywords": [
    "agent",
    "context",
    "audit",
    "cli",
    "cursor",
    "copilot",
    "claude",
    "codex"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "picocolors": "^1.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.15.7",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  }
}
